@import "tailwindcss";

/* ============================================================
   ALL PAWS INN — DESIGN SYSTEM
   Concept: the country inn. Warm paper, deep moss, oak, brass.
   Editorial, not app-like. Architectural, not bubbly.
   ============================================================ */

@theme {
  /* ---- Color ------------------------------------------------ */
  --color-bone: #fdfbf7; /* page ground */
  --color-parchment: #f6f1e8; /* alternating sections */
  --color-linen: #ede6d9; /* insets, table banding */
  --color-linen-deep: #e0d6c4; /* hairline on parchment */

  --color-ink: #1e1c18; /* primary type */
  --color-slate: #4a463e; /* secondary type */
  --color-muted: #655e54; /* tertiary, captions — 5.2:1 on linen, the darkest light ground */

  --color-moss: #2f3d33; /* dark ground, primary button */
  --color-moss-deep: #212b24; /* deepest ground */
  --color-moss-soft: #3d5142; /* hover on moss */
  --color-sage: #a8b5a0; /* quiet support fill */
  --color-sage-pale: #cfd8c9;

  --color-ember: #a34a26; /* THE accent — one moment per page. 4.8:1 on linen */
  --color-ember-deep: #85391a;
  /* Decorative only — dots and rules, never text. */
  --color-ember-mark: #b4562f;
  --color-brass: #7d622e; /* hairline marks, sparing */

  --color-success: #46644a;
  --color-warning: #7f561f;
  --color-danger: #9c3b28;

  /* ---- Type ------------------------------------------------- */
  --font-display: var(--font-fraunces), "Iowan Old Style", Georgia, serif;
  --font-sans: var(--font-instrument), ui-sans-serif, system-ui, sans-serif;
  --font-mono: var(--font-jetbrains), ui-monospace, "SF Mono", monospace;

  /* Fluid display scale — compositional, not decorative */
  --text-display-1: clamp(2.75rem, 1.6rem + 5.1vw, 6.5rem);
  --text-display-2: clamp(2.25rem, 1.45rem + 3.55vw, 4.75rem);
  --text-display-3: clamp(1.875rem, 1.35rem + 2.35vw, 3.375rem);
  --text-title-1: clamp(1.5rem, 1.2rem + 1.33vw, 2.25rem);
  --text-title-2: clamp(1.25rem, 1.1rem + 0.67vw, 1.625rem);
  --text-lead: clamp(1.0625rem, 1rem + 0.4vw, 1.3125rem);

  /* ---- Motion ----------------------------------------------- */
  --ease-entrance: cubic-bezier(0.22, 1, 0.36, 1);
  --ease-exit: cubic-bezier(0.4, 0, 1, 1);

  /* ---- Elevation -------------------------------------------- */
  /* Exactly ONE shadow exists in this system. Hairlines do the rest. */
  --shadow-lift: 0 -1px 0 rgb(30 28 24 / 0.06), 0 -12px 32px -12px rgb(30 28 24 / 0.16);

  /* ---- Layout ----------------------------------------------- */
  --spacing-gutter: clamp(1.25rem, 0.6rem + 2.6vw, 3.5rem);
}

/* ---- Base -------------------------------------------------- */
@layer base {
  :root {
    --header-h: 68px;
    --hairline: color-mix(in oklab, var(--color-ink) 12%, transparent);
    --hairline-strong: color-mix(in oklab, var(--color-ink) 22%, transparent);
    --hairline-invert: color-mix(in oklab, var(--color-bone) 20%, transparent);
    color-scheme: light;
  }

  @media (min-width: 1024px) {
    :root {
      --header-h: 84px;
    }
  }

  * {
    min-width: 0;
  }

  html {
    -webkit-text-size-adjust: 100%;
    scroll-behavior: smooth;
    /* body's overflow propagates to the viewport, so clipping must be declared
       here to actually take effect. Layout should never rely on it. */
    overflow-x: clip;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  body {
    background: var(--color-bone);
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    overflow-x: clip;
  }

  h1, h2, h3, h4 {
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: -0.018em;
    line-height: 1.06;
    text-wrap: balance;
    font-variation-settings: "SOFT" 24, "WONK" 1;
  }

  p {
    text-wrap: pretty;
  }

  /* Focus: one ring, everywhere, always visible on keyboard. */
  :focus-visible {
    outline: 2px solid var(--color-ember);
    outline-offset: 3px;
    border-radius: 2px;
  }

  ::selection {
    background: var(--color-sage-pale);
    color: var(--color-ink);
  }

  /* Numerals in specs, rates and dates should align. */
  table, .tabular {
    font-variant-numeric: tabular-nums;
  }
}

/* ---- Component primitives ---------------------------------- */
@layer components {
  /* The signature form: a semicircular arch, referencing barn doors
     and inn windows. Used sparingly — hero-weight images only. */
  .arch {
    border-radius: 9999px 9999px 3px 3px;
  }
  @media (max-width: 640px) {
    /* Flatten where a full arch would crop the subject badly. */
    .arch {
      border-radius: 40vw 40vw 3px 3px;
    }
  }

  .hairline {
    border-color: var(--hairline);
  }

  /* Editorial rule used to open sections. */
  .rule {
    height: 1px;
    background: var(--hairline);
  }

  /* Image frames crop; they never scale the layout. */
  .frame {
    overflow: hidden;
    position: relative;
    background: var(--color-linen);
  }
  .frame img {
    transition: transform 600ms var(--ease-entrance);
  }
  @media (hover: hover) {
    .frame-hover:hover img {
      transform: scale(1.03);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .frame img {
      transition: none;
    }
    .frame-hover:hover img {
      transform: none;
    }
  }

  /* Micro label — mono, letterspaced. Specs, eyebrows, rates, hours. */
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
    font-weight: 500;
  }

  /* Link that underlines on hover from the left. */
  .link-underline {
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 320ms var(--ease-entrance);
  }
  .link-underline:hover {
    background-size: 100% 1px;
  }
  @media (prefers-reduced-motion: reduce) {
    .link-underline {
      transition: none;
    }
  }
}

@layer utilities {
  /* Scroll reveal — opacity + 12px rise, once. */
  .reveal {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 600ms var(--ease-entrance),
      transform 600ms var(--ease-entrance);
  }
  .reveal[data-shown="true"] {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  .no-scrollbar {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }

  /* Horizontal snap rails (mobile matrices, galleries) */
  .snap-rail {
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
  }
  .snap-rail > * {
    scroll-snap-align: start;
  }
}
